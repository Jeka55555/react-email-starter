  >
    <table
      align="center"
      width="100%"
      border="0"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      style="max-width:37.5em;border:1px solid #eee;border-radius:5px;box-shadow:0 5px 10px rgba(20,50,70,.2)"
    >
